# ── Servidor ──────────────────────────────
PORT=3000
NODE_ENV=development

# ── Base de dados PostgreSQL ──────────────
# A base de dados do projecto corre no serviço Docker `db`.
# DB_HOST/DB_PORT só são usados pelo backend quando este corre fora do Docker.
DB_HOST=localhost
DB_PORT=5437
# Porta publicada no host pelo Compose (127.0.0.1:5437 -> 5432 no container).
DB_PORT_FORWARD=5437
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ── JWT ────────────────────────────────────
# Gera valores fortes, ex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# ── CORS ───────────────────────────────────
# Domínios/origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# ── Admin React (build Docker) ─────────────
# URL pública da API embutida no bundle do Admin Web 2.0.
ADMIN_WEB_2_API_URL=http://localhost:3001/api

# ── Cookie de refresh (painel web) ─────────
# O refresh token do painel web é enviado num cookie HttpOnly.
# Em produção, AUTH_COOKIE_SECURE assume true por defeito.
# Usa SameSite=None apenas com Secure=true e para frontend/API em sites distintos.
# AUTH_REFRESH_COOKIE_NAME=virtualshop_refresh
# AUTH_COOKIE_PATH=/api/auth
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAME_SITE=lax

# ── Bcrypt ─────────────────────────────────
BCRYPT_SALT_ROUNDS=12
